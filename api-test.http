### Variables
@baseUrl = http://localhost:3000
@email = admin@gmail.com
@password = Admin2026

### ============================================
### ADMIN AUTHENTICATION
### ============================================

### 1. Admin Login
# @name adminLogin
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "email": "adnen.rebai@gmail.com",
  "password": "Admin2026$"
}

### 2. Verify Admin Session
GET {{baseUrl}}/api/admin/auth/verify
Accept: application/json

### 3. Admin Logout
POST {{baseUrl}}/api/admin/auth/logout
Content-Type: application/json

### ============================================
### RECIPE CRUD OPERATIONS (Requires Admin Auth)
### ============================================

### 4. GET ALL RECIPES (Public - no auth required)
GET {{baseUrl}}/api/recipes
Accept: application/json

### 5. CREATE A NEW RECIPE (Requires admin authentication)
# @name createRecipe
POST {{baseUrl}}/api/recipes
Content-Type: application/json

{
  "title": "Crème Brûlée à la Vanille",
  "category": "Desserts",
  "time": "40 min",
  "timeMin": 40,
  "servings": 4,
  "difficulty": "Facile",
  "methods": ["four"],
  "image": "https://images.unsplash.com/photo-1470124182917-cc6e71b22ecc?w=800&h=600&fit=crop&auto=format",
  "description": "Une crème onctueuse parfumée à la vanille de Madagascar, coiffée d'un caramel craquant.",
  "ingredients": [
    { "qty": 500, "unit": "ml", "name": "crème" },
    { "qty": 5, "unit": "pcs", "name": "œufs" },
    { "qty": 80, "unit": "g", "name": "sucre" },
    { "qty": 1, "unit": "gousse", "name": "vanille" },
    { "qty": 4, "unit": "c.s.", "name": "cassonade" }
  ],
  "steps": [
    "Préchauffez le four à 150 °C. Fendez la gousse de vanille et grattez les grains.",
    "Faites chauffer la crème avec la vanille jusqu'à frémissement, retirez du feu.",
    "Fouettez les jaunes avec le sucre jusqu'à blanchiment. Versez la crème chaude en filet.",
    "Filtrez et répartissez dans des ramequins. Enfournez au bain-marie 30 min.",
    "Laissez refroidir puis réfrigérez au moins 3 heures.",
    "Au moment de servir, saupoudrez de cassonade et brûlez au chalumeau."
  ],
  "tags": ["Classique", "Vanille", "Festif"]
}

### After creating, copy the ID from the response and update below
# @recipeId = copied_id_from_response

### 6. GET SINGLE RECIPE (Public - no auth required)
GET {{baseUrl}}/api/recipes/{{recipeId}}
Accept: application/json

### 7. UPDATE RECIPE (Requires admin authentication)
PUT {{baseUrl}}/api/recipes/{{recipeId}}
Content-Type: application/json

{
  "title": "Crème Brûlée à la Vanille (Updated)",
  "category": "Desserts",
  "time": "45 min",
  "timeMin": 45,
  "servings": 6,
  "difficulty": "Facile",
  "methods": ["four"],
  "image": "https://images.unsplash.com/photo-1470124182917-cc6e71b22ecc?w=800&h=600&fit=crop&auto=format",
  "description": "Une crème onctueuse parfumée à la vanille de Madagascar, coiffée d'un caramel craquant.",
  "ingredients": [
    { "qty": 600, "unit": "ml", "name": "crème" },
    { "qty": 6, "unit": "pcs", "name": "œufs" },
    { "qty": 100, "unit": "g", "name": "sucre" },
    { "qty": 2, "unit": "gousse", "name": "vanille" },
    { "qty": 6, "unit": "c.s.", "name": "cassonade" }
  ],
  "steps": [
    "Préchauffez le four à 150 °C. Fendez les gousses de vanille et grattez les grains.",
    "Faites chauffer la crème avec la vanille jusqu'à frémissement, retirez du feu.",
    "Fouettez les jaunes avec le sucre jusqu'à blanchiment. Versez la crème chaude en filet.",
    "Filtrez et répartissez dans des ramequins. Enfournez au bain-marie 30 min.",
    "Laissez refroidir puis réfrigérez au moins 3 heures.",
    "Au moment de servir, saupoudrez de cassonade et brûlez au chalumeau."
  ],
  "tags": ["Classique", "Vanille", "Festif", "Crémeux"]
}

### 8. DELETE RECIPE (Requires admin authentication)
DELETE {{baseUrl}}/api/recipes/{{recipeId}}
Accept: application/json

