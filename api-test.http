### ============================================
### COMPLETE WORKFLOW EXAMPLE
### ============================================

### Step 1: Admin Login
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Step 2: Verify admin status
GET {{baseUrl}}/api/admin/auth/verify
Accept: application/json

### Step 3: Create a recipe (admin required)
POST {{baseUrl}}/api/recipes
Content-Type: application/json

{
  "title": "Pâtes Carbonara",
  "category": "Plats",
  "time": "20 min",
  "timeMin": 20,
  "servings": 4,
  "difficulty": "Facile",
  "methods": ["casserole", "poêle"],
  "image": "https://images.unsplash.com/photo-1612874742237-6526221588e3?w=800&h=600&fit=crop&auto=format",
  "description": "Pâtes à la sauce carbonara traditionnelle",
  "ingredients": [
    { "qty": 400, "unit": "g", "name": "spaghetti" },
    { "qty": 150, "unit": "g", "name": "pancetta" },
    { "qty": 3, "unit": "pcs", "name": "œufs" },
    { "qty": 100, "unit": "g", "name": "parmesan" }
  ],
  "steps": [
    "Cuire les pâtes al dente dans de l'eau salée",
    "Faire revenir la pancetta dans une poêle",
    "Mélanger les œufs avec le parmesan",
    "Assembler hors du feu et poivrer généreusement"
  ],
  "tags": ["Italien", "Pâtes", "Classique"]
}

### Step 4: Copy the recipe ID from the response
# @newRecipeId = copied_id_from_response

### Step 5: View the created recipe
GET {{baseUrl}}/api/recipes/{{newRecipeId}}
Accept: application/json

### Step 6: Update the recipe
PUT {{baseUrl}}/api/recipes/{{newRecipeId}}
Content-Type: application/json

{
  "title": "Pâtes Carbonara (Améliorée)",
  "description": "Pâtes à la sauce carbonara avec une touche de poivre noir",
  "difficulty": "Moyen"
}

### Step 7: Delete the recipe
DELETE {{baseUrl}}/api/recipes/{{newRecipeId}}
Accept: application/json

### Step 8: Admin Logout
POST {{baseUrl}}/api/admin/auth/logout
Content-Type: application/json

### Step 9: Try to create recipe after logout (should fail)
POST {{baseUrl}}/api/recipes
Content-Type: application/json

{
  "title": "This should fail after logout",
  "category": "Test"
}