### 17. Get Single Translation by ID
### =========================================================

GET {{baseUrl}}/api/configuration/translations/{{translationId}}


### =========================================================
### 18. Create New Translation
### =========================================================

POST {{baseUrl}}/api/configuration/translations
Content-Type: application/json

{
  "key": "recipe.6a80e788003b2babb283.title",
  "locale": "fr",
  "value": "Soupe de légumes courge-courgette",
  "type": "string",
  "namespace": "recipes"
}


### =========================================================
### 19. Update Translation
### =========================================================

PUT {{baseUrl}}/api/configuration/translations/{{translationId}}
Content-Type: application/json

{
  "value": "Soupe de légumes courge-courgette (Updated)"
}


