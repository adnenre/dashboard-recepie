### Variables
@baseUrl = https://dashboard-recepie.vercel.app/
@email = admin@gmail.com
@password = Admin2026

### =========================================================
### 1. Admin Login
### =========================================================

POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}


### =========================================================
### 2. Verify Admin Session
### =========================================================

GET {{baseUrl}}/api/admin/auth/verify


### =========================================================
### 3. List All Recipes
### =========================================================

GET {{baseUrl}}/api/recipes


### =========================================================
### 4. Create Recipe
### =========================================================

POST {{baseUrl}}/api/recipes
Content-Type: application/json

{
  "id": "67b8a1c2d3e4f5a6b7c8d9e0",
  "title": "Tarte Tatin aux Pommes",
  "titleLocales": {},
  "category": "Desserts",
  "categoryLocales": {},
  "description": "La classique tarte renversée aux pommes caramélisées, croustillante et fondante à la fois.",
  "descriptionLocales": {},
  "image": "https://images.unsplash.com/photo-1621743478914-cc8a86d7e7b5?w=800&h=600&fit=crop&auto=format",
  "prepTime": "20 min",
  "prepTimeLocales": {},
  "cookTime": "35 min",
  "cookTimeLocales": {},
  "servings": 6,
  "difficulty": "Moyen",
  "featured": false,
  "ingredients": [
    "6 pièces de Pommes",
    "100 g de Sucre",
    "80 g de Beurre",
    "1 pièce de Pâte feuilletée",
    "1 càc de Cannelle"
  ],
  "ingredientsLocales": {},
  "steps": [
    "Préchauffez le four à 200 °C. Épluchez et coupez les pommes en quartiers.",
    "Dans une poêle allant au four, faites fondre le beurre à feu moyen. Ajoutez le sucre et laissez caraméliser 5 minutes sans remuer.",
    "Disposez les pommes en rosace serrée sur le caramel. Saupoudrez de cannelle.",
    "Couvrez de la pâte feuilletée en rentrant les bords sous les pommes.",
    "Enfournez 30 à 35 minutes jusqu'à ce que la pâte soit dorée.",
    "Laissez tiédir 5 minutes, puis retournez sur un plat de service. Dégustez tiède."
  ],
  "stepsLocales": {},
  "tags": ["Classique", "Automne", "Caramel"],
  "tagsLocales": {},
  "methods": ["four"]
}
### =========================================================
### 5. Get One Recipe
### Replace RECIPE_ID with the $id returned from step 4
### =========================================================

@recipeId = 6a80e6e900209f14f732

GET {{baseUrl}}/api/recipes/{{recipeId}}


### =========================================================
### 6. Update Recipe
### =========================================================

PUT {{baseUrl}}/api/recipes/{{recipeId}}
Content-Type: application/json

{
  "title": "Updated Admin Test Recipe",
  "description": "This recipe was updated through the API.",
  "image": "",
  "category": "Dinner",
  "prepTime": "15 min",
  "cookTime": "25 min",
  "servings": 6,
  "difficulty": "Medium",
  "ingredients": [
    "3 cups flour",
    "1 cup sugar",
    "3 eggs",
    "1 cup milk"
  ],
  "steps": [
    "Mix all ingredients.",
    "Prepare the baking dish.",
    "Bake for 25 minutes."
  ],
  "tags": [
    "test",
    "updated",
    "admin"
  ],
  "featured": true
}


### =========================================================
### 7. Get Recipe Again
### Verify that the update worked
### =========================================================

GET {{baseUrl}}/api/recipes/{{recipeId}}


### =========================================================
### 8. List Recipes Again
### Verify the updated recipe appears in the list
### =========================================================

GET {{baseUrl}}/api/recipes


### =========================================================
### 9. Delete Recipe
### =========================================================

DELETE {{baseUrl}}/api/recipes/{{recipeId}}


### =========================================================
### 10. Verify Recipe Was Deleted
### Expected: 404 Recipe not found
### =========================================================

GET {{baseUrl}}/api/recipes/{{recipeId}}


### =========================================================
### 11. Admin Logout
### =========================================================

POST {{baseUrl}}/api/admin/auth/logout


### =========================================================
### 12. Verify Session After Logout
### Expected: 401 Authentication required
### =========================================================

GET {{baseUrl}}/api/admin/auth/verify


### =========================================================
### 13. Try Recipes After Logout
### Expected: 401 Authentication required
### =========================================================

GET {{baseUrl}}/api/recipes